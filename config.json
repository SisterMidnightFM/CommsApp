{
  "canvas": {
    "width": 1080,
    "height": 1350,
    "backgroundColor": "#000000"
  },
  "fonts": {
    "showNameFont": "SisterMidnight",
    "dateTimeFont": "SisterMidnight"
  },
  "textSizes": {
    "showNameDefault": 33
  },
  "colors": {
    "defaultFontColor": "white",
    "placeholderBackground": "#eeeeee",
    "placeholderText": "#999999"
  },
  "controls": {
    "zoom": {
      "min": -50,
      "max": 150,
      "default": 0
    },
    "position": {
      "min": -100,
      "max": 100,
      "default": 0,
      "dragMultiplier": 5
    }
  },
  "image": {
    "initialZoomFactor": 5
  }
}
